{
  "manifest_version": 3,
  "name": "BrandProof pre-flight check",
  "version": "1.0.0",
  "description": "Check the text you are writing against your organisation's BrandProof guidelines and Fact Vault before you publish. It never approves or changes anything.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "BrandProof check", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
