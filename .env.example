# Copy to .env (docker compose reads it). Everything is optional: with no keys the app runs fully offline.
BP_SECRET=change-me-before-real-use
BP_SEED=1
BP_DEMO_PASSWORD=demo1234
BP_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# BP_ANTHROPIC_MODEL=claude-sonnet-5-5
BP_GEMINI_MODEL=gemini-3.1-flash-lite
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/brandproof   (needs: pip install psycopg[binary])
# POSTGRES_PASSWORD=brandproof   (change for anything real)
# Postgres is the default under docker compose. For plain SQLite use: DATABASE_URL=sqlite:////app/data/brandproof.db

# --- Hardening (all optional; defaults shown) ---
# BP_ENV=production            # refuses to start if BP_SECRET is the default or under 32 characters
# BP_MAX_UPLOAD_MB=10          # per file; larger requests get 413
# BP_MAX_TEXT_CHARS=100000
# BP_RATE_LOGIN_FAILS=8/300    # failed logins per IP+email per 300 s before 429
# BP_RATE_UPLOAD=30/60         # uploads per IP per 60 s
# BP_RATE_VERIFY=60/60         # public receipt checks per IP per 60 s
# BP_RATE_LIMIT=0              # switch all rate limits off (load tests only)
